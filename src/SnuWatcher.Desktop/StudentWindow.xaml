<Window x:Class="SnuWatcher.Desktop.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SnuWatcher.Desktop.Views"
        xmlns:ui="clr-namespace:SnuWatcher.Desktop.Presentation"
        xmlns:search="clr-namespace:SnuWatcher.Windows.Presentation.Search;assembly=SnuWatcher.Windows"
        xmlns:watches="clr-namespace:SnuWatcher.Windows.Presentation.Watches;assembly=SnuWatcher.Windows"
        xmlns:settings="clr-namespace:SnuWatcher.Windows.Presentation.Settings;assembly=SnuWatcher.Windows"
        xmlns:alerts="clr-namespace:SnuWatcher.Windows.Presentation.Alerts;assembly=SnuWatcher.Windows"
        xmlns:prefs="clr-namespace:SnuWatcher.Application.Presentation.Preferences;assembly=SnuWatcher.Application"
        xmlns:shell="clr-namespace:SnuWatcher.Windows.Presentation.Shell;assembly=SnuWatcher.Windows"
        Title="SNU Watcher" Width="1180" Height="820" MinWidth="680" MinHeight="480" SizeChanged="OnWindowSizeChanged" Loaded="OnWindowLoaded"
        FontFamily="{DynamicResource Student.Font}" FontSize="14"
        Background="{DynamicResource Snu.Page}" Foreground="{DynamicResource Snu.Ink}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Student.Visible"/>
    <ui:TermLabelConverter x:Key="Student.TermLabel"/>
    <DataTemplate DataType="{x:Type search:CourseSearchViewModel}"><views:FindCoursesView/></DataTemplate>
    <DataTemplate DataType="{x:Type watches:WatchListViewModel}"><views:MyWatchesView/></DataTemplate>
    <DataTemplate DataType="{x:Type settings:SettingsViewModel}"><views:SettingsView/></DataTemplate>
    <DataTemplate DataType="{x:Type alerts:AlertHistoryViewModel}"><views:AlertsView/></DataTemplate>
    <DataTemplate DataType="{x:Type shell:StudentAlertsPlaceholder}">
      <Border Style="{DynamicResource Student.Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="{DynamicResource Ui.Alerts}" Style="{DynamicResource Student.Title}"/>
          <TextBlock ui:ResourceText.Key="{Binding MessageKey}" Margin="0,0,0,12" TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource Ui.NoReservation}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="RootLayout" SizeChanged="OnWindowSizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <!-- Only the chrome scrolls at small work areas. The page keeps a finite row viewport. -->
    <ScrollViewer x:Name="ChromeScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <!-- A white header, as on the registration site: the app's own name with the term being searched beside it,
           small utility links at the top right, and the page menu underneath. -->
      <Border x:Name="HeaderBand" Background="{DynamicResource Snu.Surface}" BorderBrush="{DynamicResource Snu.Divider}" BorderThickness="0,0,0,1" Padding="20,8,20,0">
        <StackPanel>
          <DockPanel x:Name="HeaderPanel">
            <StackPanel x:Name="UtilityPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Border x:Name="DemoBadge" Background="{DynamicResource Snu.DemoTint}" CornerRadius="4" Padding="7,1" VerticalAlignment="Center" Margin="0,0,10,0"
                      Visibility="{Binding State.IsDemo, Converter={StaticResource Student.Visible}}">
                <TextBlock x:Name="DemoLabel" Text="{DynamicResource Ui.Demo}" FontWeight="Medium" FontSize="11.5" Foreground="{DynamicResource Snu.DemoText}"/>
              </Border>
              <!-- One tap switches the language; the language in use is blue. -->
              <!-- Keep selected hover/press layers on the same fill, including Highlight/HighlightText in high contrast. -->
              <Button x:Name="KoreanLanguage" Content="KR" Click="OnKorean" AutomationProperties.Name="한국어" ToolTip="한국어">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Student.UtilityButton}"><Style.Triggers>
                  <DataTrigger Binding="{Binding State.Language}" Value="{x:Static prefs:UiLanguage.Korean}">
                    <Setter Property="Foreground" Value="{DynamicResource Snu.NavSelectedText}"/><Setter Property="Background" Value="{DynamicResource Snu.NavSelectedBackground}"/><Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="ui:Paint.Hover" Value="{DynamicResource Snu.NavSelectedBackground}"/>
                    <Setter Property="ui:Paint.Pressed" Value="{DynamicResource Snu.NavSelectedBackground}"/>
                  </DataTrigger>
                </Style.Triggers></Style></Button.Style>
              </Button>
              <TextBlock Text="|" Foreground="{DynamicResource Snu.BorderStrong}" FontSize="12" VerticalAlignment="Center"/>
              <Button x:Name="EnglishLanguage" Content="EN" Click="OnEnglish" AutomationProperties.Name="English" ToolTip="English">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Student.UtilityButton}"><Style.Triggers>
                  <DataTrigger Binding="{Binding State.Language}" Value="{x:Static prefs:UiLanguage.English}">
                    <Setter Property="Foreground" Value="{DynamicResource Snu.NavSelectedText}"/><Setter Property="Background" Value="{DynamicResource Snu.NavSelectedBackground}"/><Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="ui:Paint.Hover" Value="{DynamicResource Snu.NavSelectedBackground}"/>
                    <Setter Property="ui:Paint.Pressed" Value="{DynamicResource Snu.NavSelectedBackground}"/>
                  </DataTrigger>
                </Style.Triggers></Style></Button.Style>
              </Button>
              <TextBlock Text="|" Foreground="{DynamicResource Snu.BorderStrong}" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
              <Button x:Name="QuitButton" Content="{DynamicResource Ui.Quit}" Click="OnQuit" Style="{DynamicResource Student.UtilityButton}"/>
            </StackPanel>
            <StackPanel x:Name="BrandingPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,24,4">
              <!-- The app's own mark: never an SNU emblem or logo. -->
              <Border x:Name="BrandMark" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Snu.Navy}" VerticalAlignment="Center">
                <TextBlock Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource Snu.OnNavy}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <WrapPanel>
                  <TextBlock x:Name="BrandingTitle" Text="SNU Watcher" FontWeight="Bold" FontSize="21" Foreground="{DynamicResource Snu.Heading}" VerticalAlignment="Bottom"/>
                  <!-- The term every search uses, as the registration site shows "2026 - 겨울학기" beside its logo. -->
                  <TextBlock x:Name="TermLabel" FontSize="18" Foreground="{DynamicResource Snu.Accent}" VerticalAlignment="Bottom" Margin="9,0,0,1"
                             AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource Student.TermLabel}">
                        <Binding Path="Search.Model.State.SelectedTerm"/>
                        <Binding Path="Language" RelativeSource="{RelativeSource Self}"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </WrapPanel>
                <TextBlock x:Name="BrandingSubtitle" Text="{DynamicResource Ui.Unofficial}" FontSize="12" Foreground="{DynamicResource Snu.InkSecondary}"/>
              </StackPanel>
            </StackPanel>
          </DockPanel>
          <StackPanel x:Name="NavigationPanel" Orientation="Horizontal" Margin="0,2,0,0">
            <RadioButton x:Name="FindNavigation" GroupName="Pages" Content="{DynamicResource Ui.FindCourses}"
                         Tag="{x:Static shell:StudentPage.FindCourses}" Checked="OnNavigate" IsChecked="True" Style="{DynamicResource Student.Navigation}"/>
            <RadioButton x:Name="WatchesNavigation" GroupName="Pages" Content="{DynamicResource Ui.MyWatches}"
                         Tag="{x:Static shell:StudentPage.MyWatches}" Checked="OnNavigate" Style="{DynamicResource Student.Navigation}"/>
            <RadioButton x:Name="AlertsNavigation" GroupName="Pages" Content="{DynamicResource Ui.Alerts}"
                         Tag="{x:Static shell:StudentPage.Alerts}" Checked="OnNavigate" Style="{DynamicResource Student.Navigation}"/>
            <RadioButton x:Name="SettingsNavigation" GroupName="Pages" Content="{DynamicResource Ui.Settings}"
                         Tag="{x:Static shell:StudentPage.Settings}" Checked="OnNavigate" Style="{DynamicResource Student.Navigation}" Margin="0"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border x:Name="StatusBand" Padding="20,4,20,0">
        <StackPanel>
          <Expander x:Name="SourceStatusExpander" Header="{DynamicResource Ui.SourceStatus}" Foreground="{DynamicResource Snu.InkSecondary}" FontSize="13">
            <Border Style="{DynamicResource Student.Card}" Margin="0,4,0,6" Padding="14,10">
              <StackPanel>
                <TextBlock ui:ResourceText.Key="{Binding State.Source.MessageKey}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource Snu.Ink}" FontSize="14"/>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="{DynamicResource Ui.Reload}" Command="{Binding RefreshSourceCommand}" Style="{DynamicResource Student.SecondaryButton}"/>
                  <Button Content="{DynamicResource Ui.SourceResume}" Command="{Binding ResumeAccessCommand}" Style="{DynamicResource Student.SecondaryButton}"/>
                  <Button Content="{DynamicResource Ui.RecoverSavedState}" Command="{Binding RecoverPolicyCommand}" Style="{DynamicResource Student.SecondaryButton}"/>
                </WrapPanel>
                <TextBlock Text="{DynamicResource Ui.NoReservation}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Snu.InkSecondary}"/>
              </StackPanel>
            </Border>
          </Expander>
          <!-- High-contrast themes have no error colour, so a warning sign also marks the problem without colour. -->
          <DockPanel>
            <!-- A shape, not text: screen readers skip it and read only the message. -->
            <Path DockPanel.Dock="Left" Width="14" Height="14" Margin="0,2,6,0" VerticalAlignment="Top" Stretch="Uniform"
                  Fill="{DynamicResource Snu.Emphasis}"
                  Data="F0 M8,1 L15.5,14.5 L0.5,14.5 Z M7.2,5 L8.8,5 L8.6,10 L7.4,10 Z M7.2,11.3 L8.8,11.3 L8.8,12.9 L7.2,12.9 Z">
              <Path.Style><Style TargetType="Path"><Style.Triggers>
                <DataTrigger Binding="{Binding State.IssueKey}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers></Style></Path.Style>
            </Path>
            <TextBlock ui:ResourceText.Key="{Binding State.IssueKey}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource Snu.Emphasis}"/>
          </DockPanel>
          <TextBlock x:Name="LifecycleText" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"
                     Foreground="{DynamicResource Snu.Ink}"/>
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>
    <!-- The page normally fills its viewport. A very short work area (200% on 1280x800) gives the page a minimum
         height and scrolls it, rather than collapsing result rows beneath fixed chrome. -->
    <ScrollViewer x:Name="PageScrollViewer" Grid.Row="1" Margin="16,8,16,6" Focusable="False"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="PageContent" Content="{Binding PageContent}"
                      Height="{Binding ViewportHeight, ElementName=PageScrollViewer}"/>
    </ScrollViewer>
    <Border x:Name="FooterBand" Grid.Row="2" BorderBrush="{DynamicResource Snu.Divider}" BorderThickness="0,1,0,0" Padding="20,7">
      <TextBlock x:Name="ReservationFooter" Text="{DynamicResource Ui.NoReservation}" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource Snu.InkSecondary}"/>
    </Border>
  </Grid>
</Window>
