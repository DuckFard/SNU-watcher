<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colors follow SNU's public sites (mySNU/CRS deep navy #0F3E8E, registration blue #376DC8, light gray page with
       white cards). State colors follow KRDS: hover and pressed are darker steps of the same hue, disabled is solid
       gray (never transparency), body text is at least 4.5:1 and control borders at least 3:1 (WCAG 1.4.11).
       The app keeps its own name and mark: it must never pass for an official system.
       StudentPalette.HighContrast.xaml defines the same keys with Windows system colors. -->
  <SolidColorBrush x:Key="Snu.Page" Color="#F4F6FA"/>
  <SolidColorBrush x:Key="Snu.Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Snu.Tint" Color="#F3F7FF"/>
  <SolidColorBrush x:Key="Snu.SubBar" Color="#EEF2F7"/>
  <SolidColorBrush x:Key="Snu.Footer" Color="#EBEEF3"/>
  <SolidColorBrush x:Key="Snu.Hover" Color="#F5F8FD"/>
  <SolidColorBrush x:Key="Snu.Selected" Color="#ECF2FE"/>
  <SolidColorBrush x:Key="Snu.SelectedText" Color="#1E2124"/>
  <SolidColorBrush x:Key="Snu.SelectedMuted" Color="#464C53"/>
  <SolidColorBrush x:Key="Snu.SelectedAccent" Color="#2A5AAA"/>

  <SolidColorBrush x:Key="Snu.Navy" Color="#0F3E8E"/>
  <SolidColorBrush x:Key="Snu.NavyHover" Color="#0B2F6E"/>
  <SolidColorBrush x:Key="Snu.OnNavy" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Snu.OnNavyMuted" Color="#C9D6EC"/>
  <SolidColorBrush x:Key="Snu.Blue" Color="#376DC8"/>
  <SolidColorBrush x:Key="Snu.BlueHover" Color="#2C5CAD"/>
  <SolidColorBrush x:Key="Snu.BluePressed" Color="#1E4A92"/>
  <SolidColorBrush x:Key="Snu.BlueLight" Color="#5189D6"/>
  <SolidColorBrush x:Key="Snu.OnBlue" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Snu.Slate" Color="#39495F"/>
  <SolidColorBrush x:Key="Snu.NavText" Color="#1E2124"/>
  <SolidColorBrush x:Key="Snu.NavHoverText" Color="#376DC8"/>
  <SolidColorBrush x:Key="Snu.NavSelectedText" Color="#0F3E8E"/>
  <SolidColorBrush x:Key="Snu.NavSelectedBackground" Color="Transparent"/>

  <SolidColorBrush x:Key="Snu.Ink" Color="#1E2124"/>
  <SolidColorBrush x:Key="Snu.Heading" Color="#0F3E8E"/>
  <SolidColorBrush x:Key="Snu.InkSecondary" Color="#464C53"/>
  <SolidColorBrush x:Key="Snu.Accent" Color="#2F63B8"/>
  <SolidColorBrush x:Key="Snu.Emphasis" Color="#C8372A"/>

  <SolidColorBrush x:Key="Snu.Border" Color="#E1E6ED"/>
  <SolidColorBrush x:Key="Snu.BorderStrong" Color="#B1B8BE"/>
  <SolidColorBrush x:Key="Snu.FieldBorder" Color="#8A949E"/>
  <SolidColorBrush x:Key="Snu.FieldBorderHover" Color="#58616A"/>
  <SolidColorBrush x:Key="Snu.Divider" Color="#E6E8EA"/>
  <SolidColorBrush x:Key="Snu.Rule" Color="#1E2124"/>
  <SolidColorBrush x:Key="Snu.Focus" Color="#0F3E8E"/>

  <SolidColorBrush x:Key="Snu.ActionHover" Color="#EEF2F7"/>
  <SolidColorBrush x:Key="Snu.ActionPressed" Color="#D6E0EB"/>
  <SolidColorBrush x:Key="Snu.DisabledFill" Color="#E6E8EA"/>
  <SolidColorBrush x:Key="Snu.DisabledBorder" Color="#CDD1D5"/>
  <SolidColorBrush x:Key="Snu.DisabledText" Color="#6D7882"/>
  <SolidColorBrush x:Key="Snu.ScrollThumb" Color="#C4CAD3"/>
  <SolidColorBrush x:Key="Snu.ScrollThumbHover" Color="#8A949E"/>
  <SolidColorBrush x:Key="Snu.TooltipBackground" Color="#1E2124"/>
  <SolidColorBrush x:Key="Snu.TooltipText" Color="#FFFFFF"/>

  <SolidColorBrush x:Key="Snu.SelectedOpenText" Color="#1E5AA8"/>
  <SolidColorBrush x:Key="Snu.SelectedFullText" Color="#B42318"/>
  <SolidColorBrush x:Key="Snu.OpenTint" Color="#E6F1FB"/>
