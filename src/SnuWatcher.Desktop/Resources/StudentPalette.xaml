<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colors follow the course registration site (sugang.snu.ac.kr): a white header, #333 text, #666 secondary text,
       registration blue #376DC8 for links, the selected menu and primary actions, light lavender row dividers,
       #F9F9F9 row hover and a red-orange result count. The deep portal navy is not used, so the window stays light.
       State colors follow KRDS: hover and pressed are darker steps of the same hue, disabled is solid gray (never
       transparency), body text is at least 4.5:1 and control borders at least 3:1 (WCAG 1.4.11).
       The app keeps its own name and mark: it must never pass for an official system.
       StudentPalette.HighContrast.xaml defines the same keys with Windows system colors. -->
  <SolidColorBrush x:Key="Snu.Page" Color="#F6F7F9"/>
  <SolidColorBrush x:Key="Snu.Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Snu.Tint" Color="#F4F7FD"/>
  <SolidColorBrush x:Key="Snu.SubBar" Color="#F2F4F7"/>
  <SolidColorBrush x:Key="Snu.Footer" Color="#F2F3F5"/>
  <SolidColorBrush x:Key="Snu.Hover" Color="#F9F9F9"/>
  <SolidColorBrush x:Key="Snu.Selected" Color="#EEF3FC"/>
  <SolidColorBrush x:Key="Snu.SelectedText" Color="#222222"/>
  <SolidColorBrush x:Key="Snu.SelectedMuted" Color="#555555"/>
  <SolidColorBrush x:Key="Snu.SelectedAccent" Color="#2F62B8"/>

  <!-- "Navy" keys now carry the registration blue, so app-level accents stay light. -->
  <SolidColorBrush x:Key="Snu.Navy" Color="#376DC8"/>
  <SolidColorBrush x:Key="Snu.NavyHover" Color="#2E5FB3"/>
  <SolidColorBrush x:Key="Snu.OnNavy" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Snu.OnNavyMuted" Color="#E3ECF9"/>
  <SolidColorBrush x:Key="Snu.Blue" Color="#376DC8"/>
  <SolidColorBrush x:Key="Snu.BlueHover" Color="#2E5FB3"/>
  <SolidColorBrush x:Key="Snu.BluePressed" Color="#26519C"/>
  <SolidColorBrush x:Key="Snu.BlueLight" Color="#6A95DA"/>
  <SolidColorBrush x:Key="Snu.OnBlue" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Snu.Slate" Color="#4A5568"/>
  <SolidColorBrush x:Key="Snu.NavText" Color="#333333"/>
  <SolidColorBrush x:Key="Snu.NavHoverText" Color="#376DC8"/>
  <SolidColorBrush x:Key="Snu.NavSelectedText" Color="#376DC8"/>
  <SolidColorBrush x:Key="Snu.NavSelectedBackground" Color="Transparent"/>

  <SolidColorBrush x:Key="Snu.Ink" Color="#333333"/>
  <SolidColorBrush x:Key="Snu.Heading" Color="#222222"/>
  <SolidColorBrush x:Key="Snu.InkSecondary" Color="#666666"/>
  <SolidColorBrush x:Key="Snu.Accent" Color="#376DC8"/>
  <SolidColorBrush x:Key="Snu.Emphasis" Color="#D63B28"/>

  <SolidColorBrush x:Key="Snu.Border" Color="#E3E6EE"/>
  <SolidColorBrush x:Key="Snu.BorderStrong" Color="#C5CAD3"/>
  <SolidColorBrush x:Key="Snu.FieldBorder" Color="#8A949E"/>
  <SolidColorBrush x:Key="Snu.FieldBorderHover" Color="#5E6670"/>
  <SolidColorBrush x:Key="Snu.Divider" Color="#E0E2F2"/>
  <SolidColorBrush x:Key="Snu.Rule" Color="#888A96"/>
  <SolidColorBrush x:Key="Snu.Focus" Color="#376DC8"/>

  <SolidColorBrush x:Key="Snu.ActionHover" Color="#F2F5FA"/>
  <SolidColorBrush x:Key="Snu.ActionPressed" Color="#E1E8F3"/>
  <SolidColorBrush x:Key="Snu.DisabledFill" Color="#E6E8EA"/>
  <SolidColorBrush x:Key="Snu.DisabledBorder" Color="#CDD1D5"/>
  <SolidColorBrush x:Key="Snu.DisabledText" Color="#6D7882"/>
  <SolidColorBrush x:Key="Snu.ScrollThumb" Color="#CDD2DA"/>
  <SolidColorBrush x:Key="Snu.ScrollThumbHover" Color="#8A949E"/>
  <SolidColorBrush x:Key="Snu.TooltipBackground" Color="#333333"/>
  <SolidColorBrush x:Key="Snu.TooltipText" Color="#FFFFFF"/>

  <SolidColorBrush x:Key="Snu.SelectedOpenText" Color="#2F62B8"/>
  <SolidColorBrush x:Key="Snu.SelectedFullText" Color="#C8372A"/>
  <SolidColorBrush x:Key="Snu.OpenTint" Color="#EAF1FB"/>
  <SolidColorBrush x:Key="Snu.OpenText" Color="#2F62B8"/>
  <SolidColorBrush x:Key="Snu.FullTint" Color="#FDEDEB"/>
  <SolidColorBrush x:Key="Snu.FullText" Color="#C8372A"/>
  <SolidColorBrush x:Key="Snu.UnknownTint" Color="#F1F2F4"/>
  <SolidColorBrush x:Key="Snu.UnknownText" Color="#5E6670"/>
  <SolidColorBrush x:Key="Snu.DemoTint" Color="#FDF1DC"/>
  <SolidColorBrush x:Key="Snu.DemoText" Color="#7A4A06"/>
</ResourceDictionary>
