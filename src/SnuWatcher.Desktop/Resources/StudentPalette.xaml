<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colors follow the visual language of SNU's public sites (navy header, registration-site blue, thin
       blue-gray card borders). The app keeps its own name and mark: it must never pass for an official system.
       StudentPalette.HighContrast.xaml defines the same keys with Windows system colors. -->
  <SolidColorBrush x:Key="Snu.Page" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Snu.Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Snu.Tint" Color="#F3F7FF"/>
  <SolidColorBrush x:Key="Snu.SubBar" Color="#EEF3FA"/>
  <SolidColorBrush x:Key="Snu.Footer" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="Snu.Hover" Color="#F7F9FC"/>
  <SolidColorBrush x:Key="Snu.Selected" Color="#E8EFFA"/>
  <SolidColorBrush x:Key="Snu.SelectedText" Color="#333333"/>
  <SolidColorBrush x:Key="Snu.SelectedMuted" Color="#55575C"/>
  <SolidColorBrush x:Key="Snu.SelectedAccent" Color="#2A5AAA"/>

  <SolidColorBrush x:Key="Snu.Navy" Color="#173473"/>
  <SolidColorBrush x:Key="Snu.OnNavy" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Snu.OnNavyMuted" Color="#D3DCEA"/>
  <SolidColorBrush x:Key="Snu.Blue" Color="#376DC8"/>
  <SolidColorBrush x:Key="Snu.BlueHover" Color="#2C5CAD"/>
  <SolidColorBrush x:Key="Snu.OnBlue" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Snu.Slate" Color="#39495F"/>
  <SolidColorBrush x:Key="Snu.NavSelectedText" Color="#2F63B8"/>
  <SolidColorBrush x:Key="Snu.NavSelectedBackground" Color="Transparent"/>

  <SolidColorBrush x:Key="Snu.Ink" Color="#333333"/>
  <SolidColorBrush x:Key="Snu.Heading" Color="#173473"/>
  <SolidColorBrush x:Key="Snu.InkSecondary" Color="#5F5F5F"/>
  <SolidColorBrush x:Key="Snu.Accent" Color="#2F63B8"/>
  <SolidColorBrush x:Key="Snu.Emphasis" Color="#C8372A"/>

  <SolidColorBrush x:Key="Snu.Border" Color="#C7D1DE"/>
  <SolidColorBrush x:Key="Snu.BorderStrong" Color="#8FA1BA"/>
  <SolidColorBrush x:Key="Snu.Divider" Color="#E7E7E7"/>
  <SolidColorBrush x:Key="Snu.Rule" Color="#333333"/>
  <SolidColorBrush x:Key="Snu.Focus" Color="#173473"/>

  <SolidColorBrush x:Key="Snu.OpenTint" Color="#E6F1FB"/>
  <SolidColorBrush x:Key="Snu.OpenText" Color="#0C447C"/>
  <SolidColorBrush x:Key="Snu.FullTint" Color="#FCEBEA"/>
  <SolidColorBrush x:Key="Snu.FullText" Color="#A3271D"/>
  <SolidColorBrush x:Key="Snu.UnknownTint" Color="#F1F1F1"/>
  <SolidColorBrush x:Key="Snu.UnknownText" Color="#555555"/>
  <SolidColorBrush x:Key="Snu.DemoTint" Color="#FDF1DC"/>
  <SolidColorBrush x:Key="Snu.DemoText" Color="#7A4A06"/>
</ResourceDictionary>
