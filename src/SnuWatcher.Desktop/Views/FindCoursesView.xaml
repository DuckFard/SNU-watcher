<UserControl x:Class="SnuWatcher.Desktop.Views.FindCoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SnuWatcher.Desktop.Views"
             xmlns:ui="clr-namespace:SnuWatcher.Desktop.Presentation"
             xmlns:search="clr-namespace:SnuWatcher.Windows.Presentation.Search;assembly=SnuWatcher.Windows"
             SizeChanged="OnViewSizeChanged" IsVisibleChanged="OnViewVisibleChanged">
  <UserControl.Resources>
    <ui:TermLabelConverter x:Key="Find.TermLabel"/>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{DynamicResource Snu.InkSecondary}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <!-- On a selected card, secondary and accent text switch to Snu.Selected* keys: the same tones in normal mode, and
         HighlightText in high contrast, where the selected row is painted with the Highlight system color. -->
    <Style x:Key="Card.Meta" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Snu.InkSecondary}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Snu.SelectedMuted}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card.Divider" TargetType="TextBlock" BasedOn="{StaticResource Card.Meta}">
      <Setter Property="Text" Value="|"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Snu.BorderStrong}"/>
    </Style>
    <Style x:Key="Card.Value" TargetType="TextBlock" BasedOn="{StaticResource Card.Meta}">
      <Setter Property="Foreground" Value="{DynamicResource Snu.Ink}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Snu.SelectedText}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card.Optional" TargetType="TextBlock" BasedOn="{StaticResource Card.Meta}">
      <Setter Property="Text" Value="{Binding}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Text" Value="{DynamicResource Ui.Unknown}"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value=""><Setter Property="Text" Value="{DynamicResource Ui.Unknown}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Counts are blue, as on the registration site. -->
    <Style x:Key="Card.Number" TargetType="TextBlock" BasedOn="{StaticResource Card.Meta}">
      <Setter Property="Foreground" Value="{DynamicResource Snu.Accent}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Snu.SelectedAccent}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card.Enrollment" TargetType="TextBlock" BasedOn="{StaticResource Card.Number}">
      <Setter Property="Text" Value="{Binding EnrollmentText}"/>
    </Style>
    <!-- Apparent open seats: blue when open, red when full, gray when unknown. Source arithmetic, not eligibility. -->
    <Style x:Key="Card.Seats" TargetType="TextBlock">
      <Setter Property="Text" Value="{Binding ApparentSeats}"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Foreground" Value="{DynamicResource Snu.OpenText}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding ApparentSeats}" Value="0"><Setter Property="Foreground" Value="{DynamicResource Snu.FullText}"/></DataTrigger>
        <DataTrigger Binding="{Binding ApparentSeats}" Value="{x:Null}">
          <Setter Property="Text" Value="{DynamicResource Ui.Unknown}"/>
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="Foreground" Value="{DynamicResource Snu.UnknownText}"/>
        </DataTrigger>
        <!-- A selected row is painted with the selection fill (Highlight in high contrast), so every seat state switches
             to its Selected* color there; these come last so they win over the unselected colors above. -->
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Snu.SelectedOpenText}"/>
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"/>
            <Condition Binding="{Binding ApparentSeats}" Value="0"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="Foreground" Value="{DynamicResource Snu.SelectedFullText}"/>
        </MultiDataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True"/>
            <Condition Binding="{Binding ApparentSeats}" Value="{x:Null}"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="Foreground" Value="{DynamicResource Snu.SelectedMuted}"/>
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
  </UserControl.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- One search box, after the registration site: the current term is fixed and shown, an empty search lists every
         course, and "Advanced search" folds the site's detailed filters below. -->
    <Border x:Name="SearchCard" Style="{DynamicResource Student.Card}" Padding="18,12,18,6" PreviewKeyDown="OnFiltersPreviewKeyDown">
      <StackPanel>
        <WrapPanel x:Name="SearchTitle" Margin="0,0,0,8">
          <!-- "2026 - 겨울학기 강좌 검색": the term every search uses, read from the registration site. -->
          <TextBlock x:Name="SearchTermText" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource Snu.Accent}" VerticalAlignment="Center">
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource Find.TermLabel}">
                <Binding Path="Model.State.SelectedTerm"/>
                <Binding Path="Language" RelativeSource="{RelativeSource Self}"/>
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <TextBlock x:Name="SearchTermSuffix" Text="{DynamicResource Ui.TermSearchSuffix}" FontSize="15" Foreground="{DynamicResource Snu.Heading}" VerticalAlignment="Center" Margin="5,0,0,0">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
              <DataTrigger Binding="{Binding Model.State.SelectedTerm}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock x:Name="TermStatusText" FontSize="13" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style><Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Setter Property="Foreground" Value="{DynamicResource Snu.InkSecondary}"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Model.State.SelectedTerm}" Value="{x:Null}"/>
                    <Condition Binding="{Binding Model.State.CatalogState}" Value="{x:Static search:CourseUiLoadState.Failed}"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/><Setter Property="Text" Value="{DynamicResource Ui.CurrentTermUnavailable}"/>
                  <Setter Property="Foreground" Value="{DynamicResource Snu.Emphasis}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Model.State.SelectedTerm}" Value="{x:Null}"/>
                    <Condition Binding="{Binding Model.State.CatalogState}" Value="{x:Static search:CourseUiLoadState.Loading}"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/><Setter Property="Text" Value="{DynamicResource Ui.TermLoading}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Model.State.SelectedTerm}" Value="{x:Null}"/>
                    <Condition Binding="{Binding Model.State.CatalogState}" Value="{x:Static search:CourseUiLoadState.Canceled}"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/><Setter Property="Text" Value="{DynamicResource Ui.Canceled}"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <Button x:Name="RetryTermButton" Content="{DynamicResource Ui.TryAgain}" Command="{Binding LoadCurrentTermCommand}" Margin="8,0,0,0">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Student.UtilityButton}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Model.State.SelectedTerm}" Value="{x:Null}"/>
                    <Condition Binding="{Binding Model.State.CatalogState}" Value="{x:Static search:CourseUiLoadState.Failed}"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource Snu.Accent}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Model.State.SelectedTerm}" Value="{x:Null}"/>
                    <Condition Binding="{Binding Model.State.CatalogState}" Value="{x:Static search:CourseUiLoadState.Canceled}"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource Snu.Accent}"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style></Button.Style>
          </Button>
        </WrapPanel>
        <DockPanel x:Name="SearchBar" LastChildFill="True" Margin="0,0,0,10">
          <ToggleButton x:Name="AdvancedToggle" DockPanel.Dock="Right" Style="{DynamicResource Student.FilterToggle}"
                        IsChecked="{Binding IsExpanded, ElementName=FiltersExpander, Mode=TwoWay}"
                        AutomationProperties.Name="{DynamicResource Ui.AdvancedSearch}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock x:Name="AdvancedToggleText" Text="{DynamicResource Ui.AdvancedSearch}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                         ui:Motion.Turn="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
            </StackPanel>
          </ToggleButton>
          <Button x:Name="SearchButton" DockPanel.Dock="Right" Command="{Binding SearchCommand}" Click="OnSearchClicked" MinWidth="96" MinHeight="40"
                  Margin="8,0" Style="{DynamicResource Student.PrimaryButton}" AutomationProperties.Name="{DynamicResource Ui.Search}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="{DynamicResource Ui.Search}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Grid>
            <TextBox x:Name="NameField" Text="{Binding CourseName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" MinHeight="40" FontSize="14.5"
                     Style="{DynamicResource Student.Field}" Margin="0" Padding="12,5" AutomationProperties.Name="{DynamicResource Ui.CourseName}"
                     AutomationProperties.HelpText="{DynamicResource Ui.SearchPlaceholder}"/>
            <!-- Placeholder, as on the registration site ("전체 강좌 검색은 돋보기 버튼을 클릭하세요"). -->
            <TextBlock Text="{DynamicResource Ui.SearchPlaceholder}" IsHitTestVisible="False" Margin="14,0,8,0" VerticalAlignment="Center"
                       FontSize="13.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Snu.DisabledText}">
              <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text.IsEmpty, ElementName=NameField}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
          </Grid>
        </DockPanel>

        <!-- Advanced search: the registration site's detailed filters, folded away until requested. -->
        <Expander x:Name="FiltersExpander" IsExpanded="False" Style="{DynamicResource Student.Collapsible}">
          <StackPanel>
            <Border Height="1" Background="{DynamicResource Snu.Divider}" Margin="0,0,0,8"/>
            <!-- Only filters scroll. The results list always retains its own finite viewport. -->
            <ScrollViewer x:Name="FiltersScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="150">
              <UniformGrid x:Name="FilterFields" Columns="4">
                <StackPanel>
                  <Label Target="{Binding ElementName=GradeField}"><TextBlock Text="{DynamicResource Ui.Grade}" TextWrapping="Wrap"/></Label>
                  <ComboBox x:Name="GradeField" SelectedValue="{Binding Grade}" SelectedValuePath="Tag" Style="{DynamicResource Student.Select}"
                            AutomationProperties.Name="{DynamicResource Ui.Grade}">
                    <ComboBoxItem Tag="" Content="{DynamicResource Ui.AllGrades}"/>
                    <ComboBoxItem Tag="1" Content="{DynamicResource Ui.Grade1}"/>
                    <ComboBoxItem Tag="2" Content="{DynamicResource Ui.Grade2}"/>
                    <ComboBoxItem Tag="3" Content="{DynamicResource Ui.Grade3}"/>
                    <ComboBoxItem Tag="4" Content="{DynamicResource Ui.Grade4}"/>
                    <ComboBoxItem Tag="5" Content="{DynamicResource Ui.Grade5}"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel>
                  <Label Target="{Binding ElementName=ProgramField}"><TextBlock Text="{DynamicResource Ui.Program}" TextWrapping="Wrap"/></Label>
                  <!-- The registration site's own 이수과정 codes. -->
                  <ComboBox x:Name="ProgramField" SelectedValue="{Binding Level}" SelectedValuePath="Tag" Style="{DynamicResource Student.Select}"
                            AutomationProperties.Name="{DynamicResource Ui.Program}">
                    <ComboBoxItem Tag="" Content="{DynamicResource Ui.AllPrograms}"/>
                    <ComboBoxItem Tag="C013300001" Content="{DynamicResource Ui.ProgramBachelor}"/>
                    <ComboBoxItem Tag="C013300002" Content="{DynamicResource Ui.ProgramMaster}"/>
                    <ComboBoxItem Tag="C013300003" Content="{DynamicResource Ui.ProgramDoctor}"/>
                    <ComboBoxItem Tag="C013300004" Content="{DynamicResource Ui.ProgramIntegrated}"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel>
                  <Label Target="{Binding ElementName=CollegeField}"><TextBlock Text="{DynamicResource Ui.College}" TextWrapping="Wrap"/></Label>
                  <ComboBox x:Name="CollegeField" ItemsSource="{Binding Model.State.Colleges}" SelectedItem="{Binding SelectedCollege}"
                            DisplayMemberPath="Name" Style="{DynamicResource Student.Select}" AutomationProperties.Name="{DynamicResource Ui.College}"
                            SelectionChanged="OnCollegeChanged"/>
                </StackPanel>
                <StackPanel>
                  <Label Target="{Binding ElementName=DepartmentField}"><TextBlock Text="{DynamicResource Ui.Department}" TextWrapping="Wrap"/></Label>
                  <ComboBox x:Name="DepartmentField" ItemsSource="{Binding Model.State.Departments}" SelectedItem="{Binding SelectedDepartment}"
                            DisplayMemberPath="Name" Style="{DynamicResource Student.Select}" AutomationProperties.Name="{DynamicResource Ui.Department}"/>
                </StackPanel>
                <StackPanel>
                  <Label Target="{Binding ElementName=CodeField}"><TextBlock Text="{DynamicResource Ui.CourseCode}" TextWrapping="Wrap"/></Label>
                  <TextBox x:Name="CodeField" Text="{Binding CourseCode, UpdateSourceTrigger=PropertyChanged}"
                           MaxLength="80" Style="{DynamicResource Student.Field}" AutomationProperties.Name="{DynamicResource Ui.CourseCode}"/>
                </StackPanel>
                <StackPanel>
                  <Label Target="{Binding ElementName=SectionField}"><TextBlock Text="{DynamicResource Ui.Section}" TextWrapping="Wrap"/></Label>
                  <TextBox x:Name="SectionField" Text="{Binding SectionLookup, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"
                           Style="{DynamicResource Student.Field}" AutomationProperties.Name="{DynamicResource Ui.Section}"
                           ToolTip="{DynamicResource Ui.InvalidSection}"/>
                </StackPanel>
                <StackPanel>
                  <Label Target="{Binding ElementName=InstructorField}"><TextBlock Text="{DynamicResource Ui.Instructor}" TextWrapping="Wrap"/></Label>
                  <TextBox x:Name="InstructorField" Text="{Binding Instructor, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                           Style="{DynamicResource Student.Field}" AutomationProperties.Name="{DynamicResource Ui.Instructor}"/>
                </StackPanel>
              </UniformGrid>
            </ScrollViewer>
            <DockPanel Margin="0,0,0,6">
              <WrapPanel DockPanel.Dock="Right">
                <Button Content="{DynamicResource Ui.Cancel}" Command="{Binding CancelCommand}" Style="{DynamicResource Student.QuietButton}"/>
                <Button Content="{DynamicResource Ui.Clear}" Command="{Binding ClearCommand}" Style="{DynamicResource Student.QuietButton}" Margin="0"/>
              </WrapPanel>
              <TextBlock Text="{DynamicResource Ui.SearchHint}" Style="{DynamicResource Student.Muted}" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </Expander>
        <!-- High-contrast themes have no error colour, so a warning sign also marks the problem without colour. -->
        <DockPanel Margin="0,0,0,6">
          <!-- With no term at all, the title line above already reports the failed term read beside Try again. -->
          <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Model.State.IssueKey}" Value="Ui.CurrentTermUnavailable"/>
                <Condition Binding="{Binding Model.State.SelectedTerm}" Value="{x:Null}"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Collapsed"/>
            </MultiDataTrigger>
          </Style.Triggers></Style></DockPanel.Style>
          <!-- A shape, not text: screen readers skip it and read only the message. -->
          <Path DockPanel.Dock="Left" Width="14" Height="14" Margin="0,2,6,0" VerticalAlignment="Top" Stretch="Uniform"
                Fill="{DynamicResource Snu.Emphasis}"
                Data="F0 M8,1 L15.5,14.5 L0.5,14.5 Z M7.2,5 L8.8,5 L8.6,10 L7.4,10 Z M7.2,11.3 L8.8,11.3 L8.8,12.9 L7.2,12.9 Z">
            <Path.Style><Style TargetType="Path"><Style.Triggers>
              <DataTrigger Binding="{Binding Model.State.IssueKey}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers></Style></Path.Style>
          </Path>
          <TextBlock ui:ResourceText.Key="{Binding Model.State.IssueKey}" Style="{DynamicResource Student.Label}"
                     Foreground="{DynamicResource Snu.Emphasis}" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Compact layouts display one full-height pane rather than splitting a short viewport. -->
    <TabControl x:Name="CompactPaneSelector" Grid.Row="1" Height="36" Margin="0,0,0,6" Visibility="Collapsed" Style="{DynamicResource Student.Tabs}"
                SelectionChanged="OnCompactPaneChanged" AutomationProperties.Name="{DynamicResource Ui.FindCourses}">
      <TabItem><TabItem.Header><TextBlock Text="{DynamicResource Ui.Results}"/></TabItem.Header></TabItem>
      <TabItem><TabItem.Header><TextBlock Text="{DynamicResource Ui.Details}"/></TabItem.Header></TabItem>
    </TabControl>
    <Grid x:Name="ContentLayout" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ResultColumn" Width="3*"/>
        <ColumnDefinition x:Name="SideColumn" Width="2*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="ResultRow" Height="*"/>
        <RowDefinition x:Name="SideRow" Height="0"/>
      </Grid.RowDefinitions>
      <Border x:Name="ResultPanel" Style="{DynamicResource Student.Card}" Padding="18,14,18,8" Margin="0,0,12,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel x:Name="ResultHeader" LastChildFill="True" Margin="0,0,0,4">
            <!-- Compact layouts keep "Watch selected sections" beside the list; wide layouts show it as a tab. -->
            <Button x:Name="CompactWatchButton" DockPanel.Dock="Right" Content="{DynamicResource Ui.WatchSelected}" Click="OnReviewSelectionClicked"
                    Visibility="Collapsed" Margin="0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Student.PrimaryButton}">
                  <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="12,4"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WatchSelection.Model.State.Rows.IsEmpty}" Value="True">
                      <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <WrapPanel VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Ui.Results}" Style="{DynamicResource Student.SectionTitle}" VerticalAlignment="Bottom" Margin="0,0,12,0"/>
              <!-- "279건의 교과목이 검색되었습니다": the source's own total, in the registration site's red-orange. The host
                   follows the layout height; the panel inside appears only once a search has been read. -->
              <Border x:Name="ResultTiming" VerticalAlignment="Bottom" Margin="0,0,0,2">
                <WrapPanel>
                  <WrapPanel.Style>
                    <Style TargetType="WrapPanel"><Style.Triggers>
                      <DataTrigger Binding="{Binding Model.State.SearchRead}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style>
                  </WrapPanel.Style>
                  <TextBlock x:Name="ResultCountText" Foreground="{DynamicResource Snu.Emphasis}" FontSize="13" FontWeight="Medium" Margin="0,0,3,0"
                             Text="{Binding Model.State.ResultCount}"/>
                  <TextBlock Text="{DynamicResource Ui.ResultCountSuffix}" Style="{DynamicResource Student.Muted}" FontSize="13" Margin="0,0,10,0"/>
                  <TextBlock Text="{DynamicResource Ui.SearchCompleted}" Style="{DynamicResource Student.Muted}" Margin="0,0,5,0"/>
                  <TextBlock Text="{Binding Model.State.SearchRead.CompletedAtUtc, StringFormat={}{0:u}}" Style="{DynamicResource Student.Muted}"/>
                </WrapPanel>
              </Border>
            </WrapPanel>
          </DockPanel>
          <StackPanel x:Name="ResultStatusPanel" Grid.Row="1" Margin="0,0,0,8">
            <TextBlock AutomationProperties.LiveSetting="Polite">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Student.Muted}">
                  <Setter Property="Text" Value="{DynamicResource Ui.SearchHint}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Complete}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <!-- Before any search the empty-state panel below says this, with its button. -->
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Idle}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Loading}">
                      <Setter Property="Text" Value="{DynamicResource Ui.Loading}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Partial}">
                      <Setter Property="Text" Value="{DynamicResource Ui.PartialResults}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Empty}">
                      <Setter Property="Text" Value="{DynamicResource Ui.NoResults}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Failed}">
                      <Setter Property="Text" Value="{DynamicResource Ui.DataUnavailable}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Canceled}">
                      <Setter Property="Text" Value="{DynamicResource Ui.Canceled}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <!-- Still a DataGrid: it keeps virtualization, keyboard row navigation and row/cell automation. Each row is a card. -->
          <DataGrid x:Name="ResultsGrid" Grid.Row="2" ItemsSource="{Binding Model.State.Rows}" SelectionMode="Single"
                    SelectionUnit="FullRow" SelectionChanged="OnResultsSelectionChanged" Style="{DynamicResource Student.CardList}"
                    AutomationProperties.Name="{DynamicResource Ui.Results}"
                    AutomationProperties.HelpText="{DynamicResource Ui.Eligibility}" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="*" MinWidth="240">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid Margin="0,8,6,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- Accent bar: grows in on hover and stays while the row is selected. -->
                      <Border Width="3" Background="{DynamicResource Snu.Blue}" Margin="0,-8,0,-8" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform>
                        <ui:Motion.ExpandY>
                          <MultiBinding Converter="{StaticResource Student.AnyTrue}">
                            <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                            <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=DataGridRow}"/>
                          </MultiBinding>
                        </ui:Motion.ExpandY>
                      </Border>
                      <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnSectionSelectionClicked" VerticalAlignment="Top"
                                Margin="12,0,14,0" Style="{DynamicResource Student.CircleCheck}"
                                IsEnabled="{Binding DataContext.WatchSelection.Model.State.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                AutomationProperties.Name="{DynamicResource Ui.WatchSelected}" AutomationProperties.HelpText="{Binding Row.Key}"/>
                      <StackPanel Grid.Column="2">
                        <!-- "[학사] [전선] 집중일본어 1", as on the registration site. -->
                        <WrapPanel Margin="0,0,0,2">
                          <TextBlock Text="{Binding Row.Classification}" FontSize="13.5" Margin="0,0,6,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Card.Meta}"><Style.Triggers>
                              <DataTrigger Binding="{Binding Row.Classification}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding Row.Name}" FontSize="15.5" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,2">
                          <TextBlock DataContext="{Binding Row.Instructor}" Style="{StaticResource Card.Optional}"/>
                          <TextBlock Style="{StaticResource Card.Divider}"/>
                          <TextBlock DataContext="{Binding Row.Department}" Style="{StaticResource Card.Optional}"/>
                          <TextBlock Style="{StaticResource Card.Divider}"/>
                          <TextBlock Text="{Binding Row.Key.CourseCode}" Style="{StaticResource Card.Value}" Margin="0,0,3,0"/>
                          <TextBlock Text="{Binding Row.Key.Section, StringFormat='({0})'}" Style="{StaticResource Card.Value}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,2">
                          <TextBlock Text="{DynamicResource Ui.Enrollment}" Style="{StaticResource Card.Meta}" Margin="0,0,4,0"/>
                          <!-- The source's own quota label, in parentheses as on the registration site. -->
                          <TextBlock Text="{Binding Row.QuotaLabel, StringFormat='({0})'}" Margin="0,0,5,0" ToolTip="{DynamicResource Ui.QuotaLabel}">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Card.Meta}"><Style.Triggers>
                              <DataTrigger Binding="{Binding Row.QuotaLabel}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                          </TextBlock>
                          <TextBlock Style="{StaticResource Card.Enrollment}"/>
                          <TextBlock Style="{StaticResource Card.Divider}"/>
                          <TextBlock Text="{DynamicResource Ui.TotalShort}" Style="{StaticResource Card.Meta}" Margin="0,0,5,0"/>
                          <TextBlock DataContext="{Binding Row.TotalRegistered}" Style="{StaticResource Card.Optional}"/>
                          <!-- "학점 3", shown only when the row states credits. -->
                          <StackPanel Orientation="Horizontal">
                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                              <DataTrigger Binding="{Binding Row.Credits}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Style="{StaticResource Card.Divider}"/>
                            <TextBlock Text="{DynamicResource Ui.Credits}" Style="{StaticResource Card.Meta}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Row.Credits}" Style="{StaticResource Card.Number}"/>
                          </StackPanel>
                        </WrapPanel>
                        <TextBlock DataContext="{Binding Row.Schedule}" Style="{StaticResource Card.Optional}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Margin="14,0,0,0" MinWidth="76" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Ui.Seats}" Style="{StaticResource Card.Meta}" FontSize="11.5" HorizontalAlignment="Right"
                                   TextAlignment="Right" TextWrapping="Wrap" MaxWidth="104" Margin="0,0,0,1"/>
                        <TextBlock Style="{StaticResource Card.Seats}"/>
                      </StackPanel>
                      <!-- Chevron nudges right on hover, like the arrow links on snu.ac.kr. -->
                      <TextBlock Grid.Column="4" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="14,0,0,0"
                                 VerticalAlignment="Center"
                                 ui:Motion.NudgeRight="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}">
                        <TextBlock.Style><Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Snu.BorderStrong}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Snu.Accent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Snu.SelectedMuted}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style></TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <!-- Before the first search: one button lists every course in the term, so there is always something to do. -->
          <StackPanel x:Name="StartPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,12,24" MaxWidth="420">
            <StackPanel.Style><Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Idle}">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style></StackPanel.Style>
            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Snu.Selected}" HorizontalAlignment="Center" Margin="0,0,0,12">
              <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource Snu.SelectedAccent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{DynamicResource Ui.StartTitle}" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource Snu.Heading}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="{DynamicResource Ui.SearchHint}" Style="{DynamicResource Student.Muted}" FontSize="13" TextAlignment="Center" Margin="0,0,0,14"/>
            <Button x:Name="BrowseAllButton" Content="{DynamicResource Ui.BrowseAll}" Click="OnBrowseAll" HorizontalAlignment="Center"
                    Style="{DynamicResource Student.SecondaryButton}" Margin="0" ui:Paint.Radius="18" Padding="18,8"/>
          </StackPanel>
          <!-- Paging, as on the registration site: first, previous, five page numbers, next and last. -->
          <StackPanel x:Name="PagingBar" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                      AutomationProperties.Name="{DynamicResource Ui.PageNumber}">
            <StackPanel.Style><Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Model.State.IsPaged}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              </Style.Triggers>
            </Style></StackPanel.Style>
            <Button x:Name="FirstPageButton" Content="&#xE892;" Click="OnFirstPage" IsEnabled="{Binding Model.State.HasPreviousPage}"
                    Style="{DynamicResource Student.PageArrow}" ToolTip="{DynamicResource Ui.FirstPage}" AutomationProperties.Name="{DynamicResource Ui.FirstPage}"/>
            <Button x:Name="PreviousPageButton" Content="&#xE76B;" Click="OnPreviousPage" IsEnabled="{Binding Model.State.HasPreviousPage}"
                    Style="{DynamicResource Student.PageArrow}" ToolTip="{DynamicResource Ui.PreviousPage}" AutomationProperties.Name="{DynamicResource Ui.PreviousPage}"/>
            <ItemsControl x:Name="PageNumbers" ItemsSource="{Binding Model.State.PageNumbers}" Focusable="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type search:SearchPageLink}">
                  <Button Click="OnPageNumber" Tag="{Binding Number}" AutomationProperties.Name="{Binding Number}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Student.PageButton}"><Style.Triggers>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Snu.Accent}"/><Setter Property="FontWeight" Value="Medium"/>
                      </DataTrigger>
                    </Style.Triggers></Style></Button.Style>
                    <TextBlock Text="{Binding Number}">
                      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="TextDecorations" Value="Underline"/></DataTrigger>
                      </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="NextPageButton" Content="&#xE76C;" Click="OnNextPage" IsEnabled="{Binding Model.State.HasNextPage}"
                    Style="{DynamicResource Student.PageArrow}" ToolTip="{DynamicResource Ui.NextPage}" AutomationProperties.Name="{DynamicResource Ui.NextPage}"/>
            <Button x:Name="LastPageButton" Content="&#xE893;" Click="OnLastPage" IsEnabled="{Binding Model.State.HasNextPage}"
                    Style="{DynamicResource Student.PageArrow}" ToolTip="{DynamicResource Ui.LastPage}" AutomationProperties.Name="{DynamicResource Ui.LastPage}"/>
          </StackPanel>
          <StackPanel x:Name="ResultFooter" Grid.Row="4" Margin="0,6,0,0">
            <TextBlock Text="{DynamicResource Ui.Eligibility}" Style="{DynamicResource Student.Muted}"/>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Section details and the watch form, as two tabs with the full side height. -->
      <Border x:Name="SideStack" Grid.Column="1" Style="{DynamicResource Student.Card}" Padding="16,6,16,12" Margin="0">
        <TabControl x:Name="SidePanel" Style="{DynamicResource Student.Tabs}" AutomationProperties.Name="{DynamicResource Ui.Details}">
          <TabItem><TabItem.Header><TextBlock Text="{DynamicResource Ui.Details}" TextWrapping="Wrap"/></TabItem.Header>
            <views:CourseDetailsView DataContext="{Binding Details}"/>
          </TabItem>
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Ui.WatchSelected}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <!-- How many sections are ticked, so the tab says what it will watch. -->
                <Border CornerRadius="9" MinWidth="18" Padding="5,0" Margin="6,0,0,0" Background="{DynamicResource Snu.Blue}" VerticalAlignment="Center">
                  <Border.Style><Style TargetType="Border"><Style.Triggers>
                    <DataTrigger Binding="{Binding WatchSelection.Model.State.Rows.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers></Style></Border.Style>
                  <TextBlock Text="{Binding WatchSelection.Model.State.Rows.Length}" FontSize="11.5" Foreground="{DynamicResource Snu.OnBlue}"
                             HorizontalAlignment="Center"/>
                </Border>
              </StackPanel>
            </TabItem.Header>
            <views:WatchSelectionView DataContext="{Binding WatchSelection}"/>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </Grid>
</UserControl>
