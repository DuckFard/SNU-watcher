<UserControl x:Class="SnuWatcher.Desktop.Views.FindCoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SnuWatcher.Desktop.Views"
             xmlns:ui="clr-namespace:SnuWatcher.Desktop.Presentation"
             xmlns:search="clr-namespace:SnuWatcher.Windows.Presentation.Search;assembly=SnuWatcher.Windows"
             SizeChanged="OnViewSizeChanged">
  <UserControl.Resources>
    <Style x:Key="Search.Cell" TargetType="TextBlock" BasedOn="{StaticResource Student.Label}">
      <Setter Property="Margin" Value="6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
    </Style>
    <Style x:Key="Search.EnrollmentCell" TargetType="TextBlock" BasedOn="{StaticResource Search.Cell}">
      <Setter Property="Text" Value="{Binding EnrollmentText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
          <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Search.OptionalCell" TargetType="TextBlock" BasedOn="{StaticResource Search.Cell}">
      <Setter Property="Text" Value="{Binding}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Text" Value="{DynamicResource Ui.Unknown}"/></DataTrigger>
        <DataTrigger Binding="{Binding}" Value=""><Setter Property="Text" Value="{DynamicResource Ui.Unknown}"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
  </UserControl.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Style="{DynamicResource Student.Card}" Padding="10" Margin="0,0,0,8" PreviewKeyDown="OnFiltersPreviewKeyDown">
      <StackPanel>
        <Expander x:Name="FiltersExpander" IsExpanded="True">
          <Expander.Header><TextBlock Text="{DynamicResource Ui.FindCourses}" FontSize="18" FontWeight="SemiBold"/></Expander.Header>
          <!-- Only filters scroll. The results grid always retains its own finite viewport. -->
          <ScrollViewer x:Name="FiltersScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="144" Margin="0,6,0,0">
            <StackPanel>
        <UniformGrid x:Name="FilterFields" Columns="4">
          <StackPanel>
            <Label Target="{Binding ElementName=YearField}" Padding="0"><TextBlock Text="{DynamicResource Ui.Year}" TextWrapping="Wrap"/></Label>
            <TextBox x:Name="YearField" Text="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                     MaxLength="4" Style="{DynamicResource Student.Field}" AutomationProperties.Name="{DynamicResource Ui.Year}"/>
          </StackPanel>
          <StackPanel>
            <Label Target="{Binding ElementName=TermField}" Padding="0"><TextBlock Text="{DynamicResource Ui.Term}" TextWrapping="Wrap"/></Label>
            <ComboBox x:Name="TermField" ItemsSource="{Binding Model.State.Terms}" SelectedItem="{Binding SelectedTerm}"
                      DisplayMemberPath="Name" Style="{DynamicResource Student.Select}" AutomationProperties.Name="{DynamicResource Ui.Term}"/>
          </StackPanel>
          <StackPanel>
            <Label Target="{Binding ElementName=CodeField}" Padding="0"><TextBlock Text="{DynamicResource Ui.CourseCode}" TextWrapping="Wrap"/></Label>
            <TextBox x:Name="CodeField" Text="{Binding CourseCode, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="80" Style="{DynamicResource Student.Field}" AutomationProperties.Name="{DynamicResource Ui.CourseCode}"/>
          </StackPanel>
          <StackPanel>
            <Label Target="{Binding ElementName=SectionField}" Padding="0"><TextBlock Text="{DynamicResource Ui.Section}" TextWrapping="Wrap"/></Label>
            <TextBox x:Name="SectionField" Text="{Binding SectionLookup, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"
                     Style="{DynamicResource Student.Field}" AutomationProperties.Name="{DynamicResource Ui.Section}"
                     ToolTip="{DynamicResource Ui.InvalidSection}"/>
          </StackPanel>
          <StackPanel>
            <Label Target="{Binding ElementName=NameField}" Padding="0"><TextBlock Text="{DynamicResource Ui.CourseName}" TextWrapping="Wrap"/></Label>
            <TextBox x:Name="NameField" Text="{Binding CourseName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                     Style="{DynamicResource Student.Field}" AutomationProperties.Name="{DynamicResource Ui.CourseName}"/>
          </StackPanel>
          <StackPanel>
            <Label Target="{Binding ElementName=InstructorField}" Padding="0"><TextBlock Text="{DynamicResource Ui.Instructor}" TextWrapping="Wrap"/></Label>
            <TextBox x:Name="InstructorField" Text="{Binding Instructor, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                     Style="{DynamicResource Student.Field}" AutomationProperties.Name="{DynamicResource Ui.Instructor}"/>
          </StackPanel>
          <StackPanel>
            <Label Target="{Binding ElementName=CollegeField}" Padding="0"><TextBlock Text="{DynamicResource Ui.College}" TextWrapping="Wrap"/></Label>
            <ComboBox x:Name="CollegeField" ItemsSource="{Binding Model.State.Colleges}" SelectedItem="{Binding SelectedCollege}"
                      DisplayMemberPath="Name" Style="{DynamicResource Student.Select}" AutomationProperties.Name="{DynamicResource Ui.College}"/>
          </StackPanel>
          <StackPanel>
            <Label Target="{Binding ElementName=DepartmentField}" Padding="0"><TextBlock Text="{DynamicResource Ui.Department}" TextWrapping="Wrap"/></Label>
            <ComboBox x:Name="DepartmentField" ItemsSource="{Binding Model.State.Departments}" SelectedItem="{Binding SelectedDepartment}"
                      DisplayMemberPath="Name" Style="{DynamicResource Student.Select}" AutomationProperties.Name="{DynamicResource Ui.Department}"/>
          </StackPanel>
        </UniformGrid>
              <TextBlock Text="{DynamicResource Ui.SearchHint}" Style="{DynamicResource Student.Label}"/>
            </StackPanel>
          </ScrollViewer>
        </Expander>
        <WrapPanel Margin="0,6,0,0">
          <Button Content="{DynamicResource Ui.LoadCatalog}" Command="{Binding LoadCatalogCommand}">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Student.SecondaryButton}"><Style.Triggers>
              <DataTrigger Binding="{Binding (Validation.HasError), ElementName=YearField}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers></Style></Button.Style>
          </Button>
          <Button Content="{DynamicResource Ui.Search}" Command="{Binding SearchCommand}" Click="OnSearchClicked">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Student.PrimaryButton}"><Style.Triggers>
              <DataTrigger Binding="{Binding (Validation.HasError), ElementName=YearField}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers></Style></Button.Style>
          </Button>
          <Button Content="{DynamicResource Ui.Cancel}" Command="{Binding CancelCommand}" Style="{DynamicResource Student.SecondaryButton}"/>
          <Button Content="{DynamicResource Ui.Clear}" Command="{Binding ClearCommand}" Style="{DynamicResource Student.SecondaryButton}"/>
        </WrapPanel>
        <TextBlock Text="{DynamicResource Ui.FiltersInvalid}" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Student.Label}">
            <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
              <DataTrigger Binding="{Binding (Validation.HasError), ElementName=YearField}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style></TextBlock.Style>
        </TextBlock>
        <TextBlock AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Student.Label}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Model.State.CatalogState}" Value="{x:Static search:CourseUiLoadState.Loading}">
                  <Setter Property="Visibility" Value="Visible"/><Setter Property="Text" Value="{DynamicResource Ui.Loading}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.State.CatalogState}" Value="{x:Static search:CourseUiLoadState.Failed}">
                  <Setter Property="Visibility" Value="Visible"/><Setter Property="Text" Value="{DynamicResource Ui.DataUnavailable}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock ui:ResourceText.Key="{Binding Model.State.IssueKey}" Style="{DynamicResource Student.Label}"
                   AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </Border>

    <!-- Compact layouts display one full-height pane rather than splitting a short viewport. -->
    <TabControl x:Name="CompactPaneSelector" Grid.Row="1" Height="32" Margin="0,0,0,6" Visibility="Collapsed"
                SelectionChanged="OnCompactPaneChanged" AutomationProperties.Name="{DynamicResource Ui.FindCourses}">
      <TabItem><TabItem.Header><TextBlock Text="{DynamicResource Ui.Results}"/></TabItem.Header></TabItem>
      <TabItem><TabItem.Header><TextBlock Text="{DynamicResource Ui.Details}"/></TabItem.Header></TabItem>
    </TabControl>
    <Grid x:Name="ContentLayout" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ResultColumn" Width="2*"/>
        <ColumnDefinition x:Name="SideColumn" Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="ResultRow" Height="*"/>
        <RowDefinition x:Name="SideRow" Height="0"/>
      </Grid.RowDefinitions>
      <Border x:Name="ResultPanel" Style="{DynamicResource Student.Card}" Padding="10" Margin="0,0,8,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel x:Name="ResultHeader" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="{DynamicResource Ui.WatchSelected}" Click="OnReviewSelectionClicked">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Student.PrimaryButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WatchSelection.Model.State.Rows.IsEmpty}" Value="True">
                      <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <TextBlock Text="{DynamicResource Ui.Results}" Style="{DynamicResource Student.Label}" FontSize="18" FontWeight="SemiBold"/>
          </DockPanel>
          <StackPanel x:Name="ResultStatusPanel" Grid.Row="1" Margin="0,0,0,8">
            <TextBlock AutomationProperties.LiveSetting="Polite">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Student.Label}">
                  <Setter Property="Text" Value="{DynamicResource Ui.SelectSection}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Complete}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Loading}">
                      <Setter Property="Text" Value="{DynamicResource Ui.Loading}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Partial}">
                      <Setter Property="Text" Value="{DynamicResource Ui.PartialResults}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Empty}">
                      <Setter Property="Text" Value="{DynamicResource Ui.NoResults}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Failed}">
                      <Setter Property="Text" Value="{DynamicResource Ui.DataUnavailable}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Model.State.SearchState}" Value="{x:Static search:CourseUiLoadState.Canceled}">
                      <Setter Property="Text" Value="{DynamicResource Ui.Canceled}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <WrapPanel x:Name="ResultTiming">
              <WrapPanel.Style>
                <Style TargetType="WrapPanel"><Style.Triggers>
                  <DataTrigger Binding="{Binding Model.State.SearchRead}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers></Style>
              </WrapPanel.Style>
              <TextBlock Text="{DynamicResource Ui.SearchCompleted}" Style="{DynamicResource Student.Label}" Margin="0,0,6,0"/>
              <TextBlock Text="{Binding Model.State.SearchRead.CompletedAtUtc, StringFormat={}{0:u}}" Style="{DynamicResource Student.Label}"/>
            </WrapPanel>
          </StackPanel>
          <!-- The bounded Grid slot lets the DataGrid own its scrolling and recycling. -->
          <DataGrid x:Name="ResultsGrid" Grid.Row="2" ItemsSource="{Binding Model.State.Rows}" SelectionMode="Single"
                    SelectionUnit="FullRow" SelectionChanged="OnResultsSelectionChanged" Style="{DynamicResource Student.Results}"
                    ColumnHeaderHeight="32" AutomationProperties.Name="{DynamicResource Ui.Results}"
                    AutomationProperties.HelpText="{DynamicResource Ui.Eligibility}"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="44" Header="✓">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnSectionSelectionClicked" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsEnabled="{Binding DataContext.WatchSelection.Model.State.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              AutomationProperties.Name="{DynamicResource Ui.WatchSelected}" AutomationProperties.HelpText="{Binding Row.Key}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Binding="{Binding Row.Name}" MinWidth="150" Width="2*" ElementStyle="{StaticResource Search.Cell}">
                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Ui.CourseName}" TextWrapping="Wrap"/></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding Row.Key.CourseCode}" MinWidth="120" MaxWidth="180" Width="Auto" ElementStyle="{StaticResource Search.Cell}">
                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Ui.CourseCode}" TextWrapping="Wrap"/></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding Row.Key.Section}" MinWidth="72" Width="Auto" ElementStyle="{StaticResource Search.Cell}">
                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Ui.Section}" TextWrapping="Wrap"/></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTemplateColumn MinWidth="110" Width="110">
                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Ui.Enrollment}" TextTrimming="CharacterEllipsis" ToolTip="{DynamicResource Ui.Enrollment}"/></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <TextBlock Style="{StaticResource Search.EnrollmentCell}"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn MinWidth="110" Width="110">
                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Ui.Seats}" TextTrimming="CharacterEllipsis" ToolTip="{DynamicResource Ui.Seats}"/></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="4" Margin="4" Padding="6,2">
                    <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Search.Cell}">
                      <Setter Property="Text" Value="{Binding ApparentSeats}"/>
                      <Style.Triggers><DataTrigger Binding="{Binding ApparentSeats}" Value="{x:Null}"><Setter Property="Text" Value="{DynamicResource Ui.Unknown}"/></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style></TextBlock>
                  </Border>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn MinWidth="120" MaxWidth="220" Width="Auto">
                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Ui.Instructor}" TextWrapping="Wrap"/></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <TextBlock DataContext="{Binding Row.Instructor}" Style="{StaticResource Search.OptionalCell}"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn MinWidth="150" MaxWidth="260" Width="Auto">
                <DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Ui.Schedule}" TextWrapping="Wrap"/></DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <TextBlock DataContext="{Binding Row.Schedule}" Style="{StaticResource Search.OptionalCell}"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Binding="{Binding Row.ObservedAtUtc, StringFormat={}{0:u}}" MinWidth="165" Width="Auto" ElementStyle="{StaticResource Search.Cell}">
                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Ui.ObservedAt}" TextWrapping="Wrap"/></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding Row.QuotaLabel}" MinWidth="140" Width="Auto" ElementStyle="{StaticResource Search.Cell}">
                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Ui.QuotaLabel}" TextTrimming="CharacterEllipsis"/></DataGridTextColumn.Header>
              </DataGridTextColumn>
              <DataGridTextColumn Binding="{Binding Row.TotalRegistered}" MinWidth="110" Width="Auto" ElementStyle="{StaticResource Search.Cell}">
                <DataGridTextColumn.Header><TextBlock Text="{DynamicResource Ui.TotalEnrollment}" TextTrimming="CharacterEllipsis"/></DataGridTextColumn.Header>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="ResultFooter" Grid.Row="3" Margin="0,6,0,0">
            <WrapPanel DataContext="{Binding SelectedItem.Row, ElementName=ResultsGrid}" Margin="0,0,0,4">
              <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers></Style></WrapPanel.Style>
              <TextBlock Text="{DynamicResource Ui.QuotaLabel}" Style="{DynamicResource Student.Label}" Margin="0,0,6,0"/>
              <TextBlock Margin="0,0,16,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Student.Label}">
                <Setter Property="Text" Value="{Binding QuotaLabel}"/>
                <Style.Triggers><DataTrigger Binding="{Binding QuotaLabel}" Value="{x:Null}"><Setter Property="Text" Value="{DynamicResource Ui.Unknown}"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style></TextBlock>
              <TextBlock Text="{DynamicResource Ui.TotalEnrollment}" Style="{DynamicResource Student.Label}" Margin="0,0,6,0"/>
              <TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Student.Label}">
                <Setter Property="Text" Value="{Binding TotalRegistered}"/>
                <Style.Triggers><DataTrigger Binding="{Binding TotalRegistered}" Value="{x:Null}"><Setter Property="Text" Value="{DynamicResource Ui.Unknown}"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style></TextBlock>
            </WrapPanel>
            <TextBlock Text="{DynamicResource Ui.Eligibility}" Style="{DynamicResource Student.Label}"/>
          </StackPanel>
        </Grid>
      </Border>
      <TabControl x:Name="SidePanel" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                  AutomationProperties.Name="{DynamicResource Ui.Details}">
        <TabItem><TabItem.Header><TextBlock Text="{DynamicResource Ui.Details}" TextWrapping="Wrap"/></TabItem.Header>
          <views:CourseDetailsView DataContext="{Binding Details}"/>
        </TabItem>
        <TabItem><TabItem.Header><TextBlock Text="{DynamicResource Ui.WatchSelected}" TextWrapping="Wrap"/></TabItem.Header>
          <views:WatchSelectionView DataContext="{Binding WatchSelection}"/>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</UserControl>
