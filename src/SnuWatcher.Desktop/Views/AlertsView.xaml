<UserControl x:Class="SnuWatcher.Desktop.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:present="clr-namespace:SnuWatcher.Desktop.Presentation"
             SizeChanged="OnViewSizeChanged">
  <Grid x:Name="LayoutGrid">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="CompactNavigation" Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
      <Button x:Name="ListNavigation" Content="{DynamicResource Ui.Alerts}" Click="OnShowList" Style="{StaticResource Student.SecondaryButton}"/>
      <Button x:Name="DetailsNavigation" Content="{DynamicResource Ui.Details}" Click="OnShowDetails" Style="{StaticResource Student.SecondaryButton}"/>
    </StackPanel>
    <Border x:Name="ListPanel" Grid.Row="1" Grid.Column="0" Style="{StaticResource Student.Card}" Padding="10" Margin="0,0,12,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{DynamicResource Ui.Alerts}" Style="{StaticResource Student.Title}" FontSize="22"/>
          <TextBlock Text="{DynamicResource Ui.AlertHistoryNotice}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <WrapPanel><TextBlock Text="{DynamicResource Ui.AlertLastRead}" Margin="0,0,6,0"/><TextBlock Text="{Binding State.LastSuccessfulReadAtUtc}"/></WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,6,0,6">
          <TextBlock present:ResourceText.Key="{Binding State.MessageKey}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Text="{DynamicResource Ui.AlertRowsStale}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding State.IsStale}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock Text="{DynamicResource Ui.AlertHistoryLimit}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding State.BackHistoryLimited}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          <TextBlock Text="{DynamicResource Ui.AlertNoHistory}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding State.IsLoaded}" Value="True"/><Condition Binding="{Binding State.Rows.Length}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
        <DataGrid x:Name="HistoryRows" Grid.Row="2" ItemsSource="{Binding State.Rows}" SelectedItem="{Binding SelectedRow,Mode=TwoWay}"
                  Style="{StaticResource Student.Results}" SelectionMode="Single" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="{DynamicResource Ui.Alerts}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Identifier}" Width="*" MinWidth="125"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Ui.AlertCourseSection}"/></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding OriginalSeatsText}" Width="70"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource Ui.AlertOriginalSeats}" TextWrapping="Wrap"/></DataGridTextColumn.Header></DataGridTextColumn>
            <DataGridTemplateColumn Width="145"><DataGridTemplateColumn.Header><TextBlock Text="{DynamicResource Ui.AlertDeliveryState}" TextWrapping="Wrap"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="3"><TextBlock present:ResourceText.Key="{Binding StatusKey}" TextWrapping="Wrap"/><TextBlock Text="{Binding ObservedAtText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
          <Button Content="{DynamicResource Ui.AlertLatest}" Command="{Binding LatestCommand}" Style="{StaticResource Student.SecondaryButton}"/>
          <Button Content="{DynamicResource Ui.AlertNewer}" Command="{Binding NewerCommand}" Style="{StaticResource Student.SecondaryButton}"/>
          <TextBlock Text="{Binding State.PageNumber}" VerticalAlignment="Center" Margin="6,0"/>
          <Button Content="{DynamicResource Ui.AlertOlder}" Command="{Binding OlderCommand}" Style="{StaticResource Student.SecondaryButton}"/>
          <Button Content="{DynamicResource Ui.Reload}" Command="{Binding ReloadCommand}" Style="{StaticResource Student.SecondaryButton}"/>
        </WrapPanel>
      </Grid>
    </Border>
    <Border x:Name="DetailsPanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource Student.Card}" Padding="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="{DynamicResource Ui.AlertSelectEvent}" TextWrapping="Wrap" Margin="0,0,0,8">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding State.SelectedEventId}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <TextBlock present:ResourceText.Key="{Binding State.DetailsMessageKey}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Text="{Binding State.Details.Identifier}" Style="{StaticResource Student.Title}" FontSize="20"/>
          <TextBlock Text="{DynamicResource Ui.AlertOriginalOpening}" FontWeight="SemiBold"/>
          <WrapPanel><TextBlock Text="{DynamicResource Ui.AlertOriginalSeats}" Margin="0,0,6,0"/><TextBlock Text="{Binding State.Details.OriginalSeatsText}"/></WrapPanel>
          <TextBlock Text="{Binding State.Details.ObservedAtText}" TextWrapping="Wrap"/>
          <TextBlock present:ResourceText.Key="{Binding State.Details.ReasonKey}" TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource Ui.AlertDeliveryState}" FontWeight="SemiBold" Margin="0,8,0,0"/>
          <TextBlock present:ResourceText.Key="{Binding State.Details.StatusKey}" TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource Ui.AlertAcceptedCaveat}" TextWrapping="Wrap" Margin="0,4,0,8"/>
          <WrapPanel><Button Content="{DynamicResource Ui.OpenRegistration}" Command="{Binding OpenRegistrationCommand}" Style="{StaticResource Student.PrimaryButton}"/><Button Content="{DynamicResource Ui.CopyIdentifier}" Command="{Binding CopyIdentifierCommand}" Style="{StaticResource Student.SecondaryButton}"/></WrapPanel>
          <TextBlock Text="{DynamicResource Ui.AlertOriginalRecipients}" FontWeight="SemiBold" Margin="0,12,0,4"/>
          <TextBlock Text="{DynamicResource Ui.AlertCurrentLabels}" TextWrapping="Wrap"/>
          <TextBlock present:ResourceText.Key="{Binding State.RecipientMessageKey}" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding State.Recipients}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="4" Margin="0,3"><StackPanel><TextBlock Text="{Binding WatchLabel}" TextWrapping="Wrap"/><TextBlock present:ResourceText.Key="{Binding ReasonKey}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <WrapPanel><Button Content="{DynamicResource Ui.FirstPage}" Command="{Binding RecipientFirstCommand}" Style="{StaticResource Student.SecondaryButton}"/><Button Content="{DynamicResource Ui.Previous}" Command="{Binding RecipientPreviousCommand}" Style="{StaticResource Student.SecondaryButton}"/><TextBlock Text="{Binding State.RecipientPageNumber}" VerticalAlignment="Center" Margin="6,0"/><Button Content="{DynamicResource Ui.Next}" Command="{Binding RecipientNextCommand}" Style="{StaticResource Student.SecondaryButton}"/></WrapPanel>
          <TextBlock Text="{DynamicResource Ui.AlertRecordBuckets}" FontWeight="SemiBold" Margin="0,12,0,4"/>
          <TextBlock Text="{DynamicResource Ui.AlertRecordsNotChronological}" TextWrapping="Wrap"/>
          <TextBlock present:ResourceText.Key="{Binding State.AttemptMessageKey}" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding State.Attempts}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="5" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"><StackPanel><TextBlock present:ResourceText.Key="{Binding OriginKey}" FontWeight="SemiBold"/><TextBlock present:ResourceText.Key="{Binding ContextKey}" TextWrapping="Wrap"/><TextBlock present:ResourceText.Key="{Binding OutcomeKey}" TextWrapping="Wrap"/><TextBlock Text="{Binding RecordedAtText}" TextWrapping="Wrap"/><TextBlock Text="{Binding BatchCountsText}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <WrapPanel><Button Content="{DynamicResource Ui.FirstPage}" Command="{Binding AttemptFirstCommand}" Style="{StaticResource Student.SecondaryButton}"/><Button Content="{DynamicResource Ui.Previous}" Command="{Binding AttemptPreviousCommand}" Style="{StaticResource Student.SecondaryButton}"/><TextBlock Text="{Binding State.AttemptPageNumber}" VerticalAlignment="Center" Margin="6,0"/><Button Content="{DynamicResource Ui.Next}" Command="{Binding AttemptNextCommand}" Style="{StaticResource Student.SecondaryButton}"/></WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
